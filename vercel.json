{
  "crons": [
    { "path": "/api/cron/sync-products?batch=1",  "schedule": "0 0 * * *" },
    { "path": "/api/cron/sync-products?batch=2",  "schedule": "30 1 * * *" },
    { "path": "/api/cron/sync-products?batch=3",  "schedule": "0 3 * * *" },
    { "path": "/api/cron/sync-products?batch=4",  "schedule": "30 4 * * *" },
    { "path": "/api/cron/sync-products?batch=5",  "schedule": "0 6 * * *" },
    { "path": "/api/cron/sync-products?batch=6",  "schedule": "30 7 * * *" },
    { "path": "/api/cron/sync-products?batch=7",  "schedule": "0 9 * * *" },
    { "path": "/api/cron/sync-products?batch=8",  "schedule": "30 10 * * *" },
    { "path": "/api/cron/sync-products?batch=9",  "schedule": "0 12 * * *" },
    { "path": "/api/cron/sync-products?batch=10", "schedule": "30 13 * * *" },
    { "path": "/api/cron/sync-products?batch=11", "schedule": "0 15 * * *" },
    { "path": "/api/cron/sync-products?batch=12", "schedule": "30 16 * * *" },
    { "path": "/api/cron/sync-products?batch=13", "schedule": "0 18 * * *" },
    { "path": "/api/cron/sync-products?batch=14", "schedule": "30 19 * * *" },
    { "path": "/api/cron/sync-products?batch=15", "schedule": "0 21 * * *" },
    { "path": "/api/cron/sync-products?batch=16", "schedule": "30 22 * * *" },
    { "path": "/api/cron/baby-milestone-push", "schedule": "0 23 * * *" },
    { "path": "/api/cron/weekly-push", "schedule": "0 20 * * 0" }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "www.honestbaby-care.com" }
      ],
      "destination": "https://honestbaby-care.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/article/:slug",
      "destination": "/api/article?slug=:slug"
    }
  ]
}
