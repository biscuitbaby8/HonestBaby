{
  "crons": [
    {
      "path": "/api/cron/sync-products?manual=1",
      "schedule": "0 18 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "www.honestbaby-care.com" }
      ],
      "destination": "https://honestbaby-care.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
