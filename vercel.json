{
  "crons": [
    { "path": "/api/cron/sync-products?manual=1&batch=1", "schedule": "0 0 * * *" },
    { "path": "/api/cron/sync-products?manual=1&batch=2", "schedule": "0 3 * * *" },
    { "path": "/api/cron/sync-products?manual=1&batch=3", "schedule": "0 6 * * *" },
    { "path": "/api/cron/sync-products?manual=1&batch=4", "schedule": "0 9 * * *" },
    { "path": "/api/cron/sync-products?manual=1&batch=5", "schedule": "0 12 * * *" },
    { "path": "/api/cron/sync-products?manual=1&batch=6", "schedule": "0 15 * * *" },
    { "path": "/api/cron/sync-products?manual=1&batch=7", "schedule": "0 18 * * *" },
    { "path": "/api/cron/sync-products?manual=1&batch=8", "schedule": "0 21 * * *" }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "www.honestbaby-care.com" }
      ],
      "destination": "https://honestbaby-care.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/product/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Twitterbot|LinkedInBot|Slackbot|TelegramBot|WhatsApp|Line|Discordbot|Google-InspectionTool).*"
        }
      ],
      "destination": "/api/ogp?id=:id"
    },
    {
      "source": "/category/:cat",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Twitterbot|LinkedInBot|Slackbot|TelegramBot|WhatsApp|Line|Discordbot|Google-InspectionTool).*"
        }
      ],
      "destination": "/api/ogp?cat=:cat"
    },
    {
      "source": "/article/:slug",
      "destination": "/api/article?slug=:slug"
    }
  ]
}
